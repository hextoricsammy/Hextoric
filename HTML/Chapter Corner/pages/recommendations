<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">
    <title>Chapter Corner | Dashboard</title>
</head>
<body>

    <header>
        <h1>Chapter Corner</h1>

        <p>
            <em>Your Personal Reading Space</em>
        </p>

        <nav aria-label="Main navigation">
             <a href="../index.html">Home</a> |
	    <a href="my library.html">My Library</a> |
            <a href="reading list.html">Reading List</a> |
            <a href="reading tracker.html">Reading Tracker</a> |
 	    <a href="book reviews.html">Book Reviews</a> |
            <a href="recommendations.html">Recommendations</a>|
	    <a href="book wishlist.html">Book Wishlist</a>|
